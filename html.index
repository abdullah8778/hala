  { text:'انضميت لنادي حلا وما توقعت المزايا تكون بهذا المستوى. التجربة تستاهل كل ريال.', name:'دلال ن.', role:'عضوة ذهبية', initial:'د', bg:'linear-gradient(135deg,#c47a5c,#b8925a)', stars:5 }
