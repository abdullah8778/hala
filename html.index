  { id:17, name:'محفظة جلد صغيرة',     cat:'حقائب',     price:99,  old:129, emoji:'👝', badge:'خصم',  bg:'linear-gradient(150deg,#f0e2c8,#c9a86a)', rate:4, sold:178, sizes:null, desc:'محفظة صغيرة أنيقة بتصميم عملي، تناسب حقيبتك اليومية.' },
  { id:18, name:'أسورة فاخرة',         cat:'إكسسوارات', price:149, old:null, emoji:'💍', badge:'',     bg:'linear-gradient(150deg,#f0e2c8,#d4b884)', rate:5, sold:95,  sizes:null, desc:'أسورة بتصميم فاخر وتفاصيل ذهبية ناعمة، تكمل إطلالتك.' },
  { id:19, name:'حزام جلدي أنيق',      cat:'إكسسوارات', price:129, old:169, emoji:'👔', badge:'خصم',  bg:'linear-gradient(150deg,#e8e2d8,#c4b8a0)', rate:4, sold:76,  sizes:['S','M','L'], desc:'حزام جلدي بتصميم كلاسيكي، يناسب الفساتين والبناطيل.' },
  { id:20, name:'شماغ بنقشة ناعمة',    cat:'إكسسوارات', price:179, old:null, emoji:'🧣', badge:'جديد', bg:'linear-gradient(150deg,#f5e2d6,#dbb89e)', rate:5, sold:143, sizes:null, desc:'شماغ بنقشة ناعمة ولمسة راقية، يكمّل إطلالتك الشتوية.' }
];

