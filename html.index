  { name:'فساتين',     emoji:'👗', count:84, accent:'var(--terracotta)', bg:'#f5e2d6' },
  { name:'بلوزات',     emoji:'👚', count:62, accent:'var(--rose)',       bg:'var(--blush)' },
  { name:'حقائب',      emoji:'👜', count:41, accent:'var(--gold)',       bg:'#f0e2c8' },
  { name:'أحذية',      emoji:'👠', count:37, accent:'var(--burgundy)',   bg:'#e8d0d6' },
  { name:'مكياج',      emoji:'💄', count:96, accent:'var(--rose-deep)',  bg:'#f0dbdc' },
  { name:'إكسسوارات',  emoji:'🎀', count:58, accent:'var(--olive)',      bg:'#dfe6d5' }
];

